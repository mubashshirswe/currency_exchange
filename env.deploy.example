# Eski namuna — kanonik: deploy/server/env.example
# Serverda: cp env.example .env

API_IMAGE=ghcr.io/mubashshirswe/currency_exchange:latest

APP_PORT=8080
ENV=PROD
RUN_MIGRATIONS=true

POSTGRES_USER=app
POSTGRES_PASSWORD=KUCHLI_PAROL
POSTGRES_DB=currency_exchange

REDIS_PW=
REDIS_DB=0
REDIS_ENABLED=true

JWTSECRET=KUCHLI_RANDOM_JWT_SECRET
# Access token: 1 kun
JWTExpirationInSeconds=86400
# Refresh token: 90 kun
JWTRefreshExpirationInSeconds=7776000

FIREBASE_CREDENTIALS_PATH=
# FCM: secrets/firebase-adminsdk.json + FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json
